    {
      "content": "\n<div style=\"display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; padding: 20px; background: #f5f5f5;\">\n  <div style=\"background: linear-gradient(135deg, #FF6B6B, #FF8E8E); height: 120px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;\">珊瑚红</div>\n  <div style=\"background: linear-gradient(135deg, #4ECDC4, #6EE7E7); height: 120px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;\">薄荷绿</div>\n  <div style=\"background: linear-gradient(135deg, #FFD166, #FFE299); height: 120px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #333; font-weight: bold;\">阳光黄</div>\n  <div style=\"background: linear-gradient(135deg, #06D6A0, #4AF7C8); height: 120px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;\">翡翠绿</div>\n  <div style=\"background: linear-gradient(135deg, #118AB2, #4AB9E7); height: 120px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;\">海洋蓝</div>\n  <div style=\"background: linear-gradient(135deg, #9D4EDD, #C77DFF); height: 120px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;\">紫罗兰</div>\n  <div style=\"background: linear-gradient(135deg, #FF9E6D, #FFB896); height: 120px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;\">蜜桃橙</div>\n  <div style=\"background: linear-gradient(135deg, #6A67CE, #8F8CFF); height: 120px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;\">薰衣草</div>\n  <div style=\"background: linear-gradient(135deg, #00BBF9, #4AD2FF); height: 120px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;\">天空蓝</div>\n</div>\n",
