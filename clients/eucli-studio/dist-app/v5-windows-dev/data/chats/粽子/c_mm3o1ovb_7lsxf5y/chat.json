    {
      "content": "\n<div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; padding: 30px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh;\">\n\n  <!-- 旋转卡片 -->\n  <div style=\"background: white; border-radius: 15px; padding: 25px; transform: rotate(3deg); box-shadow: 0 10px 30px rgba(0,0,0,0.2); transition: all 0.3s ease;\">\n    <div style=\"width: 60px; height: 60px; background: linear-gradient(45deg, #ff6b6b, #ff8e8e); border-radius: 50%; margin-bottom: 15px;\"></div>\n    <h3 style=\"margin: 0 0 10px 0; color: #333;\">旋转卡片</h3>\n    <p style=\"color: #666; margin: 0;\">轻微旋转的div容器</p>\n  </div>\n\n  <!-- 渐变边框 -->\n  <div style=\"background: white; border-radius: 15px; padding: 25px; position: relative; box-shadow: 0 5px 15px rgba(0,0,0,0.1);\">\n    <div style=\"position: absolute; top: -2px; left: -2px; right: -2px; bottom: -2px; background: linear-gradient(45deg, #4ecdc4, #44a08d); border-radius: 17px; z-index: -1;\"></div>\n    <div style=\"width: 60px; height: 60px; background: linear-gradient(45deg, #4ecdc4, #44a08d); border-radius: 12px; margin-bottom: 15px;\"></div>\n    <h3 style=\"margin: 0 0 10px 0; color: #333;\">渐变边框</h3>\n    <p style=\"color: #666; margin: 0;\">带有渐变边框效果的容器</p>\n  </div>\n\n  <!-- 浮动效果 -->\n  <div style=\"background: white; border-radius: 15px; padding: 25px; animation: float 3s ease-in-out infinite; box-shadow: 0 15px 35px rgba(0,0,0,0.1);\">\n    <div style=\"width: 60px; height: 60px; background: linear-gradient(45deg, #ffd166, #ffb347); border-radius: 12px; margin-bottom: 15px;\"></div>\n    <h3 style=\"margin: 0 0 10px 0; color: #333;\">浮动动画</h3>\n    <p style=\"color: #666; margin: 0;\">上下浮动的动画效果</p>\n  </div>\n\n  <!-- 3D效果 -->\n  <div style=\"background: linear-gradient(135deg, #9d4edd, #c77dff); border-radius: 15px; padding: 25px; transform: perspective(500px) rotateY(5deg); box-shadow: 20px 20px 40px rgba(0,0,0,0.2); color: white;\">\n    <div style=\"width: 60px; height: 60px; background: rgba(255,255,255,0.2); border-radius: 12px; margin-bottom: 15px; backdrop-filter: blur(5px);\"></div>\n    <h3 style=\"margin: 0 0 10px 0;\">3D透视</h3>\n    <p style=\"opacity: 0.9; margin: 0;\">带有3D透视效果的容器</p>\n  </div>\n\n  <!-- 玻璃态效果 -->\n  <div style=\"background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); border-radius: 15px; padding: 25px; border: 1px solid rgba(255,255,255,0.2); color: white;\">\n    <div style=\"width: 60px; height: 60px; background: rgba(255,255,255,0.3); border-radius: 50%; margin-bottom: 15px;\"></div>\n    <h3 style=\"margin: 0 0 10px 0;\">玻璃态</h3>\n    <p style=\"opacity: 0.9; margin: 0;\">毛玻璃效果容器</p>\n  </div>\n\n  <!-- 霓虹灯效果 -->\n  <div style=\"background: #1a1a2e; border-radius: 15px; padding: 25px; border: 2px solid #00f5d4; box-shadow: 0 0 20px rgba(0,245,212,0.5); color: #00f5d4;\">\n    <div style=\"width: 60px; height: 60px; background: #00f5d4; border-radius: 12px; margin-bottom: 15px; box-shadow: 0 0 15px rgba(0,245,212,0.7);\"></div>\n    <h3 style=\"margin: 0 0 10px 0;\">霓虹灯</h3>\n    <p style=\"opacity: 0.8; margin: 0;\">霓虹灯边框效果</p>\n  </div>\n\n  <!-- 折叠效果 -->\n  <div style=\"background: white; border-radius: 15px 0 15px 15px; padding: 25px; position: relative; box-shadow: -5px 5px 15px rgba(0,0,0,0.1);\">\n    <div style=\"position: absolute; top: 0; right: 0; width: 0; height: 0; border-style: solid; border-width: 0 30px 30px 0; border-color: transparent #ff9a00 transparent transparent;\"></div>\n    <div style=\"width: 60px; height: 60px; background: linear-gradient(45deg, #ff9a00, #ffb74d); border-radius: 12px; margin-bottom: 15px;\"></div>\n    <h3 style=\"margin: 0 0 10px 0; color: #333;\">折叠角</h3>\n    <p style=\"color: #666; margin: 0;\">带有折叠角效果的容器</p>\n  </div>\n\n  <!-- 波浪背景 -->\n  <div style=\"background: white; border-radius: 15px; padding: 25px; position: relative; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.1);\">\n    <div style=\"position: absolute; top: 0; left: 0; right: 0; height: 80px; background: linear-gradient(90deg, #00bbf9, #4ad2ff); border-radius: 15px 15px 0 0;\"></div>\n    <div style=\"position: relative; z-index: 1; margin-top: 40px;\">\n      <div style=\"width: 60px; height: 60px; background: white; border-radius: 12px; margin-bottom: 15px; border: 3px solid #00bbf9;\"></div>\n      <h3 style=\"margin: 0 0 10px 0; color: #333;\">波浪顶栏</h3>\n      <p style=\"color: #666; margin: 0;\">带有波浪顶栏的容器</p>\n    </div>\n  </div>\n\n</div>\n\n<style>\n@keyframes float {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(-10px); }\n}\n</style>\n",
