      "content": "\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>测试页面</title>\n    <style>\n        body {\n            margin: 0;\n            padding: 20px;\n            font-family: Arial, sans-serif;\n        }\n        .container {\n            border: 1px solid #ccc;\n            border-radius: 8px;\n            padding: 20px;\n            max-width: 800px;\n            margin: 0 auto;\n        }\n        .header {\n            background-color: #f0f0f0;\n            padding: 15px;\n            border-radius: 4px;\n            margin-bottom: 20px;\n            text-align: center;\n        }\n        .content {\n            display: flex;\n            gap: 15px;\n            margin-bottom: 20px;\n        }\n        .card {\n            flex: 1;\n            background-color: #e8f4fd;\n            padding: 20px;\n            border-radius: 6px;\n            text-align: center;\n        }\n        .footer {\n            background-color: #f9f9f9;\n            padding: 15px;\n            border-radius: 4px;\n            text-align: center;\n            color: #666;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"header\">\n            <h1>页面标题</h1>\n            <p>这是一个测试容器布局</p>\n        </div>\n        <div class=\"content\">\n            <div class=\"card\">\n                <h3>内容区块1</h3>\n                <p>这是第一个内容卡片</p>\n            </div>\n            <div class=\"card\">\n                <h3>内容区块2</hh3>\n                <p>这是第二个内容卡片</p>\n            </div>\n            <div class=\"card\">\n                <h3>内容区块3</h3>\n                <p>这是第三个内容卡片</p>\n            </div>\n        </div>\n        <div class=\"footer\">\n            <p>© 2023 测试页面 | 底部信息区域</p>\n        </div>\n    </div>\n</body>\n</html>\n",
