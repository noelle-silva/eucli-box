{
  "schemaVersion": 1,
  "id": "eucli-box",
  "start": {
    "executable": "eucli-box.exe"
  },
  "ready": {
    "type": "log",
    "match": "is ready"
  },
  "connection": {
    "port": {
      "type": "file",
      "path": "data/.meta/port.json",
      "format": "json",
      "field": "port"
    },
    "key": {
      "type": "file",
      "path": "data/.meta/box.key",
      "format": "text"
    }
  },
  "stop": {
    "type": "terminate"
  }
}
